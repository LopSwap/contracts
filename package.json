{
  "name": "@lopswap/contracts",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git@github.com:lopswap/contracts.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@1inch/limit-order-protocol-contract": "4.0.3",
    "@1inch/solidity-utils": "7.0.2",
    "@openzeppelin/contracts": "5.6.1"
  },
  "resolutions": {
    "**/@1inch/solidity-utils": "7.0.2",
    "**/hardhat": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-ethers": "4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.12",
    "@nomicfoundation/hardhat-mocha": "4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-verify": "3.1.2",
    "@rocketh/node": "0.21.4",
    "chai": "6.2.2",
    "eslint": "10.12.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
    "ethers": "6.17.0",
    "globals": "15.15.0",
    "hardhat": "3.19.0",
    "hardhat-deploy": "2.0.30",
    "hardhat-gas-reporter": "2.3.0",
    "hardhat-tracer": "3.4.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "rocketh": "0.23.1",
    "solc": "0.8.37",
    "solhint": "6.2.5",
    "solidity-coverage": "0.8.17",
    "solidity-docgen": "0.6.0-beta.36"
  },
  "scripts": {
    "clean": "rimraf artifacts generated cache coverage coverage.json",
    "coverage": "HARDHAT_MODE=coverage hardhat test --coverage",
    "deploy": "hardhat deploy --network",
    "docify": "hardhat build && node scripts/docgen.js",
    "fmt": "yarn prettier --write test deploy",
    "fmt:check": "yarn prettier --check test deploy",
    "lint": "yarn run fmt:check && yarn run lint:js && yarn run lint:sol",
    "lint:fix": "yarn run fmt && yarn run lint:js:fix && yarn run lint:sol:fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:sol": "solhint --noPoster --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:sol:fix": "solhint --noPoster --max-warnings 0 \"contracts/**/*.sol\" --fix",
    "test": "HARDHAT_MODE=parallel hardhat test",
    "test:ci": "hardhat test"
  }
}
